{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grokmcp",
  "main": "src/worker.ts",
  // Advance only with a Wrangler/vitest-pool release whose bundled workerd and
  // Miniflare both support the newer date. The current coherent stack ends here.
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "upload_source_maps": true,
  "vars": {
    "GROK_X_SEARCH_MODEL": "grok-4.6"
  },
  "secrets": {
    "required": ["MCP_URL_TOKEN", "ADMIN_URL_TOKEN", "TOKEN_ENCRYPTION_KEY"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROK_STATE",
        "class_name": "GrokState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GrokState"]
    }
  ],
  // URL path segments are bearer credentials. Keep Worker invocation logging
  // disabled so Cloudflare does not retain the MCP or administration URL.
  "observability": {
    "enabled": false
  }
}
